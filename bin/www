#!/usr/bin/env node
const http = require('http');
const { createApp } = require('../app');

const port = Number.parseInt(process.env.PORT || '3110', 10);

let app;
try {
  app = createApp({ secret: process.env.JWT_SECRET });
} catch (err) {
  console.error(`imkit-auth: ${err.message}`);
  process.exit(1);
}

const server = http.createServer(app);
server.listen(port, () => {
  console.log(`imkit-auth listening on ${server.address().port}`);
});

function shutdown() {
  server.close(() => process.exit(0));
}
process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);
